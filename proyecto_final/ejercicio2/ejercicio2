import json

# ============================================================
# PUNTO A: DOMINIO DEL CATÁLOGO Y REGLAS DE INVENTARIO
# ============================================================

class StockInvalidoError(Exception):
    """Excepción personalizada para impedir asignaciones de stock invalidadas/negativas."""
    pass

class DispositivoEcologico:
    """
    Clase base de productos ecológicos.
    Aplica encapsulamiento explícito para el stock mediante @property y @setter.
    """
    def __init__(self, nombre: str, precio: float, stock: int):
        self.nombre = nombre
        self.precio = precio
        self._stock = 0
        self.stock = stock  # Invoca al setter para validar el stock inicial

    @property
    def stock(self) -> int:
        return self._stock

    @stock.setter
    def stock(self, valor: int):
        # Validación de regla de negocio: el stock no puede ser negativo
        if valor < 0:
            raise StockInvalidoError(
                f"Error de Inventario: No se permite un stock negativo ({valor})."
            )
        self._stock = valor

    def obtener_ficha_tecnica(self) -> dict:
        """Retorna la ficha técnica comercial base del dispositivo."""
        return {
            "tipo": "Dispositivo Ecológico General",
            "nombre": self.nombre,
            "precio": self.precio,
            "stock": self.stock
        }

    def to_dict(self) -> dict:
        """Convierte la instancia en un diccionario para la serialización a JSON."""
        return self.obtener_ficha_tecnica()

class PanelSolar(DispositivoEcologico):
    """
    Clase especializada para paneles solares que hereda de DispositivoEcologico.
    Aplica polimorfismo al sobreescribir obtener_ficha_tecnica().
    """
    def __init__(self, nombre: str, precio: float, stock: int, potencia_watts: int, eficiencia_porcentaje: float):
        super().__init__(nombre, precio, stock)
        self.potencia_watts = potencia_watts
        self.eficiencia_porcentaje = eficiencia_porcentaje

    def obtener_ficha_tecnica(self) -> dict:
        """Polimorfismo: extiende la ficha técnica base con los atributos del panel solar."""
        ficha = super().obtener_ficha_tecnica()
        ficha.update({
            "tipo": "Panel Solar",
            "potencia_watts": self.potencia_watts,
            "eficiencia": f"{self.eficiencia_porcentaje}%"
        })
        return ficha

# ============================================================
# PUNTO B: PERSISTENCIA Y GESTIÓN DEL CATÁLOGO
# ============================================================

class GestorInventario:
    """Clase encargada de la persistencia y almacenamiento en disco del catálogo."""
    
    @staticmethod
    def guardar_catalogo_json(lista_dispositivos: list, ruta_archivo: str = "catalogo_ecotech.json") -> None:
        """Serializa la lista de dispositivos ecológicos y la guarda en un archivo JSON."""
        datos_serializables = [dispositivo.to_dict() for dispositivo in lista_dispositivos]
        with open(ruta_archivo, "w", encoding="utf-8") as archivo:
            json.dump(datos_serializables, archivo, indent=4, ensure_ascii=False)
        print(f"Catálogo exportado exitosamente a '{ruta_archivo}'.")

